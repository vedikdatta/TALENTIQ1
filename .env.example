# ==============================================================================
# TalentIQ Environment Configuration
# Copy this file to .env and configure your credentials
# ==============================================================================

# Supabase Project URL (from your Supabase Project Settings -> API)
# Example: https://abcdefghijklmno.supabase.co
SUPABASE_URL=https://jhziamtbxjuwbzgyljub.supabase.co


# Supabase Publishable / Anon Key (from Project Settings -> API)
# Starts with eyJhbGciOi... or sb_publishable_...
SUPABASE_KEY=sb_publishable_xwwLjIgqK6JZ9ttH_9GzIw_T5xc3uGd 

# Port exposed on the host machine (default: 8501)
PORT=8501
TALENTIQ_PORT=8501

# Set to 1 to keep SMTP email credentials session-only and never persist to disk
TALENTIQ_DISABLE_SAVED_SMTP=0 
